{
  "model_tier": "14b",
  "temperature": 0.6,
  "max_tokens": 900,
  "context": 4096,
  "max_steps": 8,
  "memory_limit": 200,
  "memory_in_prompt": 20,
  "language": "bn",
  "workdir": "~/agent-work",
  "max_output": 4000,
  "shell_timeout": 240,
  "tools": [
    "run_shell",
    "write_file",
    "read_file",
    "list_dir",
    "fetch_url",
    "web_search",
    "download_file",
    "send_file",
    "remember"
  ],
  "presets_file": "prompts.json",
  "base_prompt": "solas_prompt.md",
  "telegram": {
    "max_chars": 3900,
    "history_messages": 14,
    "stream": true,
    "edit_every_sec": 2.0
  },
  "github": {
    "schedule_hours": 5,
    "run_minutes": 340
  }
}
